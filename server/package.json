{
  "name": "server",
  "version": "1.0.0",
  "description": "Text-to-Learn API server",
  "main": "server.js",
  "type": "commonjs",
  "license": "ISC",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "test:all": "npm test && npm run test:integration",
    "migrate:status": "node scripts/migrate-generation-status.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.0",
    "mongoose": "^9.6.3",
    "pdfkit": "^0.19.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "pdf-lib": "1.17.1"
  }
}
