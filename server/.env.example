# --- Required ---

# MongoDB connection string (Atlas or local).
# Example (Atlas): mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/text-to-learn
MONGO_URI=

# Google Gemini API key — used to generate course outlines and lesson content.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Optional ---

# Gemini model id. Defaults to gemini-2.5-flash if unset.
# Change this if your key doesn't have access to the default model.
GEMINI_MODEL=gemini-2.5-flash

# YouTube Data API v3 key — used to attach related videos to lessons.
# OPTIONAL: if left blank, lessons are generated without videos (no errors).
# Get one at https://console.cloud.google.com (enable "YouTube Data API v3").
YOUTUBE_API_KEY=

# Port the API server listens on. Defaults to 3001 if unset.
PORT=3001

# Shared secret required on every /api request, sent as the X-API-Token
# header. LEAVE BLANK for local development. SET IT on any deployed
# instance: the generation endpoints each cost a billed Gemini call, and an
# ungated public URL is an open billing endpoint. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The client needs the same value as VITE_API_TOKEN.
API_ACCESS_TOKEN=

# Interface to bind. Defaults to 127.0.0.1 (loopback only). A platform host
# usually needs 0.0.0.0.
HOST=127.0.0.1

# Number of proxy hops to trust, as an integer. Leave blank when there is no
# proxy. Set it to 1 behind a single platform load balancer, so the rate
# limiter sees the real client address instead of the proxy's. Do not guess
# high: trusting more hops than exist lets a client spoof its address and
# bypass the limiter entirely.
TRUST_PROXY=

# Origin allowed by CORS (e.g. https://your-client.example.com). Defaults to
# http://localhost:5173, the Vite dev server. Set it to your deployed
# client's origin.
CLIENT_ORIGIN=
