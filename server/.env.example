# Required: MongoDB Atlas or another replica set (standalone MongoDB cannot
# execute the transactions used when creating courses).
MONGO_URI=
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Only needed when AI_PROVIDER=gemini.
GEMINI_API_KEY=

# Optional provider settings. No YouTube key means no videos.
GEMINI_MODEL=gemini-2.5-flash
YOUTUBE_API_KEY=

# Local development defaults. Production Docker overrides these at runtime.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=

# Required with NODE_ENV=production; set both or neither in development.
# HTTP Basic authentication protects the entire app, assets, and API.
# Use the same-origin production build to test browser authentication.
# Generate a password with: openssl rand -hex 32
APP_USERNAME=
APP_PASSWORD=
