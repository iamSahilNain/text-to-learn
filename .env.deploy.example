# Copy to .env.deploy, chmod 600, then fill in all required values.
# Use a hostname only (no scheme, path or port), with DNS pointing at this host.
DOMAIN=learn.example.com
ACME_EMAIL=you@example.com
APP_IMAGE_TAG=local

# One private-app login. Keep these server-side; never use VITE_ for secrets.
APP_USERNAME=owner
# Generate a password with: openssl rand -hex 32
APP_PASSWORD=

# External MongoDB replica set reachable from the container.
# Atlas example: mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/text_to_learn
MONGO_URI=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: leave blank to omit video enrichment.
YOUTUBE_API_KEY=
