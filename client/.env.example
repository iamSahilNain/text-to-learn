# Optional development override. Unset: http://localhost:3001 in development,
# same origin in production. The Docker build requires no client env file.
# Every VITE_ value is public browser configuration; never put secrets here.
# VITE_API_URL=http://localhost:3001

# Which routes and copy this build mounts: "demo" (public sample, no
# generation) or "private" (default; the full authenticated app). This is
# presentation only, never an authorization boundary -- access control lives
# entirely on the server. An unrecognized non-empty value fails the build.
# VITE_APP_MODE=private
