# Base URL of the backend API. Defaults to http://localhost:3001 if unset.
# Vite only exposes vars prefixed with VITE_ to the browser.
VITE_API_URL=http://localhost:3001

# Shared secret for a gated API, sent as the X-API-Token header. Must match
# the server's API_ACCESS_TOKEN. Leave blank for local development.
#
# Note: anything in a VITE_ variable is compiled into the JavaScript bundle
# and is readable by anyone who loads the page. This keeps crawlers and
# drive-by scanners off the generation endpoints; it does not keep out
# someone who opens devtools. It is a deployment gate, not authentication.
VITE_API_TOKEN=
